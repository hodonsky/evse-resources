  "license": "RPL",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "mocha --exit --require /usr/src/deps/node_modules/babel-core/register",
    "build": "esbuild ${SOA_PATH} --bundle --outfile=./dist/index.js --platform=node --sourcemap",
    "prestart": "npx pm2 flush",
    "start": "npx pm2 start --time --no-daemon ./dist/index.js -i 1",
    "restart": "npx pm2 kill && sleep 2 && npm start",
    "poststart": "npx logs --format 'all'"
  },
