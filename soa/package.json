    "@hodonsky/node-service": "^2.0.1",
    "crypto-js": "^4.2.0",
    "koa-sslify": "5.0.1",
    "koa-morgan": "1.0.1",
    "koa-helmet": "8.0.1",
    "koa-cors": "0.0.16",
    "njwt": "^2.0.1",
    "pm2": "^6.0.5",
    "sha256": "^0.2.0",
    "uuid": "^11.1.0"
  },
